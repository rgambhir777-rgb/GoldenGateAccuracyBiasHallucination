# GoldenGate settings. Copy to .env (or edit from the dashboard Settings page).
# Everything works with NO keys: the offline judge and the demo releases need nothing.

# --- Optional LLM provider keys (enable the LLM judge and the `llm` RAG system) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (Azure, local vLLM, Ollama's /v1, ...)
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Judge ---
# auto = LLM judge when a key is set, otherwise offline | offline | llm (falls back to offline on errors)
GOLDENGATE_JUDGE_MODE=auto
GOLDENGATE_JUDGE_MODEL=claude-sonnet-5-5
GOLDENGATE_RAG_MODEL=claude-opus-5-5
GOLDENGATE_OPENAI_MODEL=gpt-4o-mini

# --- Retrieval and statistics ---
GOLDENGATE_RETRIEVER=bm25        # bm25 | tfidf
GOLDENGATE_TOP_K=5
GOLDENGATE_BOOTSTRAP_SAMPLES=1000
